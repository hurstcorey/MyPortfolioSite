# YouTube Data API v3 key — server-only, never exposed to the browser.
# Acquire at: https://console.cloud.google.com/apis/credentials
# Required APIs: YouTube Data API v3
YOUTUBE_API_KEY=

# Public YouTube channel ID — surfaced in the browser for the "Subscribe" deep link.
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=

# Public Archidekt folder ID backing the "Commander Decks" section.
# Optional — defaults to 1708348. No API key is needed; the folder must be public.
NEXT_PUBLIC_ARCHIDEKT_FOLDER_ID=1708348

# Resend transactional email API key (existing — required for the contact form)
RESEND_API_KEY=
FROM_EMAIL=

# Spotify Web API credentials — server-only, never exposed to the browser.
# Acquire by creating an app at: https://developer.spotify.com/dashboard
# This feature uses the Client Credentials flow only (no user OAuth required).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Public Spotify user ID — surfaced in the browser if a profile deep link is added.
NEXT_PUBLIC_SPOTIFY_USER_ID=12150900787
